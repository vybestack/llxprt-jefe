{
  "schema": 1,
  "name": "actions-mode",
  "platform": "macos",
  "terminal": {
    "cols": 100,
    "rows": 24
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "work",
        "mode": 448
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n"
        },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt Jefe",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "g",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Inspectable Actions fixture",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "Oldest Actions fixture run"
      ],
      "absent": []
    },
    {
      "op": "assert-frame",
      "contains": [
        "> \u2717 Inspectable Actions fixture"
      ],
      "absent": []
    },
    {
      "op": "assert-frame",
      "contains": [
        "Enter detail"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "end",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Interleaved Actions fixture run",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "up",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "> \u2717 Interleaved Actions fixture run",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "home",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "> \u2717 Inspectable Actions fixture",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "enter",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Jobs:",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "> \u25b8 \u2713 build-linux-with-a-long-job-name"
      ],
      "absent": []
    },
    {
      "op": "assert-frame",
      "contains": [],
      "absent": [
        "Checkout fixture source"
      ]
    },
    {
      "op": "key",
      "key": "right",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Checkout fixture source",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "\u2713 [1] Checkout fixture source"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "escape",
      "modifiers": []
    },
    {
      "op": "assert-frame",
      "contains": [],
      "absent": [
        "Checkout fixture source"
      ]
    },
    {
      "op": "assert-frame",
      "contains": [
        "> \u25b8 \u2713 build-linux-with-a-long-job-name"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "assert-frame",
      "contains": [
        "> \u25b8 \u2717 test-suite-with-a-long-job-name"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "enter",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Run failing fixture tests",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "\u2717 [1] Run failing fixture tests"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "escape",
      "modifiers": []
    },
    {
      "op": "assert-frame",
      "contains": [],
      "absent": [
        "Run failing fixture tests"
      ]
    },
    {
      "op": "key",
      "key": "escape",
      "modifiers": []
    },
    {
      "op": "assert-frame",
      "contains": [
        "Inspectable Actions fixture"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "escape",
      "modifiers": []
    },
    {
      "op": "assert-frame",
      "contains": [],
      "absent": [
        "Workflow Runs"
      ]
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": []
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
