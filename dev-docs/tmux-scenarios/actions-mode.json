{
  "schema": 1,
  "name": "actions-mode",
  "platform": "macos",
  "terminal": {
    "cols": 100,
    "rows": 24
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "work",
        "mode": 448
      },
      {
        "path": "work/repo",
        "mode": 448
      },
      {
        "path": "private",
        "mode": 448
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n"
        },
        "mode": 384
      },
      {
        "path": "config/state.json",
        "content": {
          "utf8": "{\n  \"schema_version\": 1,\n  \"repositories\": [\n    {\n      \"id\": \"issue194-repo\",\n      \"name\": \"actions-fixture\",\n      \"slug\": \"actions-fixture\",\n      \"base_dir\": \"repo\",\n      \"default_profile\": \"\",\n      \"default_code_puppy_model\": \"\",\n      \"github_repo\": \"owner/actions-fixture\",\n      \"remote\": {\n        \"enabled\": false,\n        \"host\": \"\",\n        \"user\": \"\",\n        \"port\": null\n      },\n      \"issue_base_prompt\": \"\",\n      \"default_agent_kind\": \"llxprt\",\n      \"agent_ids\": []\n    }\n  ],\n  \"agents\": [],\n  \"selected_repository_index\": 0,\n  \"selected_agent_index\": null,\n  \"hide_idle_repositories\": false,\n  \"last_selected_agent_by_repo\": [],\n  \"pane_focus\": \"\",\n  \"terminal_focused\": false,\n  \"user_preferences\": {}\n}\n"
        },
        "mode": 384
      }
    ],
    "env": [
      {
        "name": "GH_SHIM_AUDIT",
        "value": "${workspace}/private/gh-audit.log"
      }
    ]
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt Jefe",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "g",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Inspectable Actions fixture",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "Oldest Actions fixture run"
      ],
      "absent": []
    },
    {
      "op": "assert-frame",
      "contains": [
        "> ✗ Inspectable Actions fixture"
      ],
      "absent": []
    },
    {
      "op": "assert-frame",
      "contains": [
        "Enter detail"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "end",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Interleaved Actions fixture run",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "up",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "> ✗ Interleaved Actions fixture run",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "home",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "> ✗ Inspectable Actions fixture",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "enter",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Jobs:",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "> ▸ ✓ build-linux-with-a-long-job-name"
      ],
      "absent": []
    },
    {
      "op": "assert-frame",
      "contains": [],
      "absent": [
        "Checkout fixture source"
      ]
    },
    {
      "op": "key",
      "key": "right",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Checkout fixture source",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "✓ [1] Checkout fixture source"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "escape",
      "modifiers": []
    },
    {
      "op": "assert-frame",
      "contains": [],
      "absent": [
        "Checkout fixture source"
      ]
    },
    {
      "op": "assert-frame",
      "contains": [
        "> ▸ ✓ build-linux-with-a-long-job-name"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "assert-frame",
      "contains": [
        "> ▸ ✗ test-suite-with-a-long-job-name"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "enter",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Run failing fixture tests",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "✗ [1] Run failing fixture tests"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "escape",
      "modifiers": []
    },
    {
      "op": "assert-frame",
      "contains": [],
      "absent": [
        "Run failing fixture tests"
      ]
    },
    {
      "op": "key",
      "key": "escape",
      "modifiers": []
    },
    {
      "op": "assert-frame",
      "contains": [
        "Inspectable Actions fixture"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "escape",
      "modifiers": []
    },
    {
      "op": "assert-frame",
      "contains": [],
      "absent": [
        "Workflow Runs"
      ]
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": []
    },
    {
      "op": "assert-file",
      "file": {
        "path": "private/gh-audit.log.accepted-actions-runs-page-1"
      }
    },
    {
      "op": "assert-file",
      "file": {
        "path": "private/gh-audit.log.accepted-actions-runs-page-2"
      }
    },
    {
      "op": "assert-file",
      "file": {
        "path": "private/gh-audit.log.accepted-actions-workflows"
      }
    },
    {
      "op": "assert-file",
      "file": {
        "path": "private/gh-audit.log.accepted-run-view-19401"
      }
    },
    {
      "op": "assert-file",
      "file": {
        "path": "private/gh-audit.log.accepted-run-jobs-19401"
      }
    },
    {
      "op": "assert-file",
      "file": {
        "path": "private/gh-audit.log.rejected",
        "exists": false
      }
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
