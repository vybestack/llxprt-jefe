{
  "schema": 1,
  "name": "agent-resolver-order",
  "platform": "linux",
  "terminal": {
    "cols": 120,
    "rows": 36
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "repo/.llxprt/bin",
        "mode": 493
      },
      {
        "path": "repo",
        "mode": 493
      },
      {
        "path": "config",
        "mode": 448
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n[[repositories]]\nid = \"repo\"\nname = \"Repo\"\nslug = \"repo\"\nbase_dir = \"${workspace}/repo\"\n"
        },
        "mode": 384
      }
    ],
    "env": [
      {
        "name": "HARNESS_ISSUE382_PROBE_MODE",
        "value": "resolver"
      }
    ]
  },
  "steps": [
    {
      "op": "capture",
      "name": "repo-llxprt",
      "path": "repo/.llxprt/bin/llxprt",
      "behavior": {
        "stdout": "repo-local-llxprt\n",
        "stderr": "",
        "exit_code": 0,
        "stdin_limit": 0,
        "hang": false,
        "spawn_child_hang": false
      }
    },
    {
      "op": "capture",
      "name": "path-llxprt",
      "path": "bin/llxprt",
      "behavior": {
        "stdout": "path-llxprt\n",
        "stderr": "",
        "exit_code": 0,
        "stdin_limit": 0,
        "hang": false,
        "spawn_child_hang": false
      }
    },
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "repo"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Agent Types",
      "timeout_ms": 15000
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt",
      "timeout_ms": 15000
    },
    {
      "op": "assert-capture",
      "capture": {
        "name": "repo-llxprt",
        "invocation": 1,
        "argv": [
          "repo/.llxprt/bin/llxprt"
        ],
        "env": [],
        "cwd": "${workspace}/repo",
        "stdout": "repo-local-llxprt\n",
        "exit_code": 0
      }
    },
    {
      "op": "assert-frame",
      "contains": [
        "LLxprt",
        "Installed",
        "enabled"
      ],
      "absent": [
        "Not found",
        "error"
      ]
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
