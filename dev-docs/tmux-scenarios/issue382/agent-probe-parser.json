{
  "schema": 1,
  "name": "agent-probe-parser",
  "platform": "linux",
  "terminal": {
    "cols": 120,
    "rows": 36
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "repo",
        "mode": 493
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n[[repositories]]\nid = \"repo\"\nname = \"Repo\"\nslug = \"repo\"\nbase_dir = \"${workspace}/repo\"\n"
        },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "repo"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Agent Types",
      "timeout_ms": 15000
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt",
      "timeout_ms": 15000
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Codex",
      "timeout_ms": 15000
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Claude",
      "timeout_ms": 15000
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Code Puppy",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "LLxprt",
        "Codex",
        "Claude",
        "Code Puppy"
      ],
      "absent": [
        "Probe error"
      ]
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
