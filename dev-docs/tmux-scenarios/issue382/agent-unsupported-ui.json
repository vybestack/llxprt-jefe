{
  "schema": 1,
  "name": "agent-unsupported-ui",
  "platform": "macos",
  "terminal": {
    "cols": 120,
    "rows": 36
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "repo",
        "mode": 493
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n"
        },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "capture",
      "name": "claude",
      "path": "bin/claude",
      "behavior": {
        "stdout": "2.1.212 (Claude Code)\n",
        "stderr": "",
        "exit_code": 0,
        "stdin_limit": 0,
        "hang": false,
        "spawn_child_hang": false
      }
    },
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "repo"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Claude Code  Installed, enabled",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "a",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "enter",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "New Agent",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "Claude Code",
        "> Resume: Supported",
        "Fresh Issue: Supported",
        "Remote: Unsupported: Claude remote/setup is not fixture-verified",
        "Model: []",
        "Prompt: []",
        "[Create enabled]",
        "[Back]"
      ],
      "absent": [
        "lacks required capability",
        "[Create disabled]",
        "Agent Runtime",
        "Mode Flags",
        "Sandbox Engine"
      ]
    },
    {
      "op": "key",
      "key": "tab",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "tab",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "tab",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "tab",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "> Remote: Unsupported: Claude remote/setup is not fixture-verified",
      "timeout_ms": 5000
    },
    {
      "op": "key",
      "key": "enter",
      "modifiers": []
    },
    {
      "op": "assert-file",
      "file": {
        "path": ".captures/claude/3.json",
        "exists": false
      }
    },
    {
      "op": "assert-file",
      "file": {
        "path": "repo/.jefe-unsupported-preparation",
        "exists": false
      }
    },
    {
      "op": "resize",
      "size": {
        "cols": 54,
        "rows": 16
      }
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "New Agent",
      "timeout_ms": 5000
    },
    {
      "op": "assert-frame",
      "contains": [
        "Claude Code",
        "Unsupported",
        "[Create enabled]"
      ],
      "absent": [
        "lacks required capability",
        "[Create disabled]"
      ]
    },
    {
      "op": "key",
      "key": "tab",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "tab",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "tab",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "tab",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "tab",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "tab",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "> [Back]",
      "timeout_ms": 5000
    },
    {
      "op": "key",
      "key": "enter",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Agent Types",
      "timeout_ms": 5000
    },
    {
      "op": "resize",
      "size": {
        "cols": 120,
        "rows": 36
      }
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Claude Code  Installed, enabled",
      "timeout_ms": 5000
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
