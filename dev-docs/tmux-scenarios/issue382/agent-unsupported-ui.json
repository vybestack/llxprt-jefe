{
  "schema": 1,
  "name": "agent-unsupported-ui",
  "platform": "macos",
  "terminal": { "cols": 120, "rows": 36 },
  "workspace": {
    "mode": 448,
    "dirs": [
      { "path": "config", "mode": 448 },
      { "path": "repo", "mode": 493 }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n"
        },
        "mode": 384
      }
    ],
    "env": [
      { "name": "PATH", "value": "${workspace}/bin:/usr/bin:/bin" }
    ]
  },
  "steps": [
    {
      "op": "capture",
      "name": "claude",
      "path": "bin/claude",
      "behavior": {
        "stdout": "2.1.212 (Claude Code)\n",
        "stderr": "",
        "exit_code": 0,
        "stdin_limit": 0,
        "hang": false,
        "spawn_child_hang": false
      }
    },
    {
      "op": "launch",
      "argv": ["jefe", "--config", "${workspace}/config"],
      "env": [],
      "cwd": "repo"
    },
    { "op": "wait", "source": "frame", "literal": "Claude Code  Installed, enabled", "timeout_ms": 15000 },
    { "op": "key", "key": "enter", "modifiers": [] },
    { "op": "wait", "source": "frame", "literal": "New Agent", "timeout_ms": 15000 },
    {
      "op": "assert-frame",
      "contains": [
        "Claude Code",
        "> Resume: Unsupported: installed Claude Code lacks required capability `resume`",
        "Fresh Issue:",
        "Remote: Unsupported: Claude remote/setup is not fixture-verified",
        "Model: []  disabled: installed Claude Code lacks required capability `model`",
        "Prompt",
        "[Create disabled]",
        "[Back]"
      ],
      "absent": [
        "[Create enabled]",
        "Fresh Issue: Unsupported",
        "Agent Runtime",
        "Mode Flags",
        "Sandbox Engine"
      ]
    },
    { "op": "key", "key": "tab", "modifiers": [] },
    { "op": "wait", "source": "frame", "literal": "> Fresh Issue:", "timeout_ms": 5000 },
    { "op": "key", "key": "up", "modifiers": [] },
    { "op": "wait", "source": "frame", "literal": "> Resume: Unsupported", "timeout_ms": 5000 },
    { "op": "key", "key": "enter", "modifiers": [] },
    {
      "op": "assert-file",
      "file": { "path": ".captures/claude/3.json", "exists": false }
    },
    {
      "op": "assert-file",
      "file": { "path": "repo/.jefe-unsupported-preparation", "exists": false }
    },
    { "op": "resize", "size": { "cols": 54, "rows": 16 } },
    { "op": "wait", "source": "frame", "literal": "New Agent", "timeout_ms": 5000 },
    {
      "op": "assert-frame",
      "contains": ["Claude Code", "Unsupported", "[Create disabled]"],
      "absent": ["[Create enabled]"]
    },
    { "op": "key", "key": "escape", "modifiers": [] },
    { "op": "resize", "size": { "cols": 120, "rows": 36 } },
    { "op": "wait", "source": "frame", "literal": "> Claude Code", "timeout_ms": 5000 },
    { "op": "finish" }
  ],
  "secrets": []
}
