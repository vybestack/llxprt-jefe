{
  "schema": 1,
  "name": "agent-probe-negative",
  "platform": "linux",
  "terminal": {
    "cols": 120,
    "rows": 36
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "repo",
        "mode": 493
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n[[repositories]]\nid = \"repo\"\nname = \"Repo\"\nslug = \"repo\"\nbase_dir = \"${workspace}/repo\"\n"
        },
        "mode": 384
      }
    ],
    "env": [
      {
        "name": "HARNESS_ISSUE382_PROBE_MODE",
        "value": "negative"
      }
    ]
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "repo"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Agent Types",
      "timeout_ms": 15000
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "AGT-E202",
      "timeout_ms": 15000
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Reprobe",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "Probe error",
        "AGT-E202",
        "Reprobe"
      ],
      "absent": [
        "enabled"
      ]
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
