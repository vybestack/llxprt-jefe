{
  "schema": 1,
  "name": "agent-incompatible-zero-spawn",
  "platform": "macos",
  "terminal": {
    "cols": 120,
    "rows": 36
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "repo",
        "mode": 493
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n"
        },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "capture",
      "name": "code-puppy",
      "path": "bin/code-puppy",
      "behavior": {
        "stdout": "llxprt 0.10.0\n",
        "stderr": "",
        "exit_code": 0,
        "stdin_limit": 0,
        "hang": false,
        "spawn_child_hang": false
      }
    },
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "repo"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Code Puppy  Incompatible",
      "timeout_ms": 15000
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "identity mismatch",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "Code Puppy  Incompatible, enabled  [Create disabled]",
        "identity mismatch"
      ],
      "absent": [
        "Code Puppy  Installed",
        "Code Puppy  Incompatible, enabled  [Create enabled]",
        "missing required capability"
      ]
    },
    {
      "op": "assert-capture",
      "capture": {
        "name": "code-puppy",
        "invocation": 1,
        "argv": [
          "${workspace}/bin/code-puppy",
          "--version"
        ],
        "env": [],
        "cwd": "${workspace}/repo"
      }
    },
    {
      "op": "assert-file",
      "file": {
        "path": ".captures/code-puppy/2.json",
        "exists": false
      }
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
