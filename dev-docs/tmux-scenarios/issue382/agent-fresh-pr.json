      "source": "frame",
      "literal": "> LLxprt",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "enter",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
