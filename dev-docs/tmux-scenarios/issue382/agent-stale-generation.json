{
  "schema": 1,
  "name": "agent-stale-generation",
  "platform": "linux",
  "terminal": {
    "cols": 120,
    "rows": 36
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "repo",
        "mode": 493
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n[[repositories]]\nid = \"repo\"\nname = \"Repo\"\nslug = \"repo\"\nbase_dir = \"${workspace}/repo\"\n"
        },
        "mode": 384
      }
    ],
    "env": [
      {
        "name": "TERM",
        "value": "xterm-256color"
      }
    ]
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "repo"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt",
      "timeout_ms": 15000
    },
    {
      "op": "write",
      "file": {
        "path": "bin/llxprt",
        "content": {
          "utf8": "#!/bin/sh\n# executable changed after probe: must trigger AGT-E203\nprintf '0.10.0-nightly.260720.changedafterprobe\\n'\n"
        },
        "mode": 493
      }
    },
    {
      "op": "key",
      "key": "enter",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "AGT-E203",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "AGT-E203",
        "no process was started",
        "Reprobe"
      ],
      "absent": [
        "Running",
        "started"
      ]
    },
    {
      "op": "key",
      "key": "escape",
      "modifiers": []
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
