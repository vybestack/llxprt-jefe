{
  "schema": 1,
  "name": "agent-stale-generation",
  "platform": "linux",
  "terminal": {
    "cols": 120,
    "rows": 36
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "repo",
        "mode": 493
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n"
        },
        "mode": 384
      },
      {
        "path": "config/state.json",
        "content": {
          "utf8": "{\n  \"state_schema\": 2,\n  \"revision\": 1,\n  \"repositories\": [\n    {\n      \"id\": \"repo\",\n      \"location\": {\n        \"local_path\": \"${workspace}/repo\"\n      },\n      \"display_name\": \"Repo\",\n      \"agent_defaults\": {\n        \"type_id\": \"core.llxprt\",\n        \"values\": {}\n      }\n    }\n  ],\n  \"agents\": [],\n  \"selection\": {\n    \"repository_id\": \"repo\",\n    \"agent_id\": null,\n    \"screen_id\": \"core.dashboard\"\n  },\n  \"last_selected_agent_by_repo\": {},\n  \"preferences\": {\n    \"hide_idle_repositories\": false,\n    \"pane_focus\": \"agents\",\n    \"terminal_focused\": false,\n    \"repository_preferences\": {}\n  },\n  \"dormant_records\": []\n}\n"
        },
        "mode": 384
      }
    ],
    "env": [
      {
        "name": "TERM",
        "value": "xterm-256color"
      }
    ]
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "repo"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt",
      "timeout_ms": 15000
    },
    {
      "op": "write",
      "file": {
        "path": "bin/llxprt",
        "content": {
          "utf8": "#!/bin/sh\n# executable changed after probe: must trigger AGT-E203\nprintf '0.10.0-nightly.260720.changedafterprobe\\n'\n"
        },
        "mode": 493
      }
    },
    {
      "op": "key",
      "key": "enter",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "AGT-E203",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "AGT-E203",
        "no process was started",
        "Reprobe"
      ],
      "absent": [
        "Running",
        "started"
      ]
    },
    {
      "op": "key",
      "key": "escape",
      "modifiers": []
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
