{
  "schema": 1,
  "name": "agent-sandbox-preflight",
  "platform": "linux",
  "terminal": {
    "cols": 120,
    "rows": 36
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "repo",
        "mode": 493
      }
    ],
    "files": [],
    "env": []
  },
  "steps": [
    {
      "op": "capture",
      "name": "git-clone",
      "path": "bin/git",
      "behavior": {
        "stdout": "",
        "stderr": "",
        "exit_code": 0,
        "stdin_limit": 0,
        "hang": false,
        "spawn_child_hang": false
      }
    },
    {
      "op": "capture",
      "name": "prompt-write",
      "path": "bin/prompt-write",
      "behavior": {
        "stdout": "",
        "stderr": "",
        "exit_code": 0,
        "stdin_limit": 0,
        "hang": false,
        "spawn_child_hang": false
      }
    },
    {
      "op": "capture",
      "name": "tmux-effect",
      "path": "bin/tmux",
      "behavior": {
        "stdout": "",
        "stderr": "",
        "exit_code": 0,
        "stdin_limit": 0,
        "hang": false,
        "spawn_child_hang": false
      }
    },
    {
      "op": "capture",
      "name": "ssh",
      "path": "bin/ssh",
      "behavior": {
        "stdout": "",
        "stderr": "",
        "exit_code": 0,
        "stdin_limit": 0,
        "hang": false,
        "spawn_child_hang": false
      }
    },
    {
      "op": "capture",
      "name": "agent-spawn",
      "path": "bin/agent-spawn",
      "behavior": {
        "stdout": "",
        "stderr": "",
        "exit_code": 0,
        "stdin_limit": 0,
        "hang": false,
        "spawn_child_hang": false
      }
    },
    {
      "op": "launch",
      "argv": [
        "jefe-harness-probe"
      ],
      "env": [],
      "cwd": "repo"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "PROBE READY",
      "timeout_ms": 15000
    },
    {
      "op": "text",
      "text": "issue382-preflight\n"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "PREFLIGHT REFUSED: engine missing: issue382-missing-engine",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "PREFLIGHT REFUSED: engine missing: issue382-missing-engine"
      ],
      "absent": [
        "Running",
        "started"
      ]
    },
    {
      "op": "assert-file",
      "file": {
        "path": ".captures/git-clone/1.json",
        "exists": false
      }
    },
    {
      "op": "assert-file",
      "file": {
        "path": ".captures/prompt-write/1.json",
        "exists": false
      }
    },
    {
      "op": "assert-file",
      "file": {
        "path": ".captures/tmux-effect/1.json",
        "exists": false
      }
    },
    {
      "op": "assert-file",
      "file": {
        "path": ".captures/ssh/1.json",
        "exists": false
      }
    },
    {
      "op": "assert-file",
      "file": {
        "path": ".captures/agent-spawn/1.json",
        "exists": false
      }
    },
    {
      "op": "text",
      "text": "exit\n"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "PROBE EXITING",
      "timeout_ms": 15000
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
