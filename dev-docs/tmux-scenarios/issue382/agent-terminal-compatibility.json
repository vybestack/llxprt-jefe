{
  "schema": 1,
  "name": "agent-terminal-compatibility",
  "platform": "linux",
  "terminal": {
    "cols": 120,
    "rows": 36
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "repo",
        "mode": 493
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n[[repositories]]\nid = \"repo\"\nname = \"Repo\"\nslug = \"repo\"\nbase_dir = \"${workspace}/repo\"\n"
        },
        "mode": 384
      }
    ],
    "env": [
      {
        "name": "TERM",
        "value": "xterm-256color"
      }
    ]
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "repo"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "enter",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "terminal",
      "timeout_ms": 15000
    },
    {
      "op": "resize",
      "size": {
        "cols": 100,
        "rows": 30
      }
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "terminal",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "c",
      "modifiers": [
        "control"
      ]
    },
    {
      "op": "key",
      "key": "f12",
      "modifiers": []
    },
    {
      "op": "assert-frame",
      "contains": [
        "LLxprt",
        "terminal"
      ],
      "absent": [
        "stopped",
        "unknown"
      ]
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
