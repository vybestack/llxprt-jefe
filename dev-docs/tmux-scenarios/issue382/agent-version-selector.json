{
  "schema": 1,
  "name": "agent-version-selector",
  "platform": "linux",
  "terminal": { "cols": 120, "rows": 36 },
  "workspace": {
    "mode": 448,
    "dirs": [
      { "path": "bin", "mode": 493 },
      { "path": "config", "mode": 448 },
      { "path": "repo", "mode": 493 }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n[[repositories]]\nid = \"repo\"\nname = \"Repo\"\nslug = \"repo\"\nbase_dir = \"${workspace}/repo\"\n"
        },
        "mode": 384
      }
    ],
    "env": [
      { "name": "PATH", "value": "${workspace}/bin:/usr/bin:/bin" },
      { "name": "TERM", "value": "xterm-256color" }
    ]
  },
  "steps": [
    {
      "op": "capture",
      "name": "npm-runner",
      "path": "bin/npm",
      "behavior": {
        "stdout": "npm exec -> resolved\n",
        "stderr": "",
        "exit_code": 0,
        "stdin_limit": 0,
        "hang": false,
        "spawn_child_hang": false
      }
    },
    {
      "op": "capture",
      "name": "uvx-runner",
      "path": "bin/uvx",
      "behavior": {
        "stdout": "uvx --from code-puppy==0.0.634 -> code-puppy\n",
        "stderr": "",
        "exit_code": 0,
        "stdin_limit": 0,
        "hang": false,
        "spawn_child_hang": false
      }
    },
    {
      "op": "launch",
      "argv": ["jefe", "--config", "${workspace}/config"],
      "env": [],
      "cwd": "repo"
    },
    { "op": "wait", "source": "frame", "literal": "Agent Types", "timeout_ms": 15000 },
    { "op": "wait", "source": "frame", "literal": "LLxprt", "timeout_ms": 15000 },
    { "op": "wait", "source": "frame", "literal": "Codex", "timeout_ms": 15000 },
    { "op": "wait", "source": "frame", "literal": "Claude", "timeout_ms": 15000 },
    { "op": "wait", "source": "frame", "literal": "Code Puppy", "timeout_ms": 15000 },
    {
      "op": "assert-capture",
      "capture": {
        "name": "npm-runner",
        "invocation": 1,
        "argv": ["npm", "exec", "--yes", "--package=@vybestack/llxprt-code@latest", "--", "llxprt"],
        "env": [],
        "cwd": "${workspace}/repo",
        "stdout": "npm exec -> resolved\n",
        "exit_code": 0
      }
    },
    {
      "op": "assert-capture",
      "capture": {
        "name": "uvx-runner",
        "invocation": 1,
        "argv": ["uvx", "--from", "code-puppy==0.0.634", "code-puppy"],
        "env": [],
        "cwd": "${workspace}/repo",
        "stdout": "uvx --from code-puppy==0.0.634 -> code-puppy\n",
        "exit_code": 0
      }
    },
    {
      "op": "assert-frame",
      "contains": ["LLxprt", "Codex", "Claude", "Code Puppy"],
      "absent": ["error"]
    },
    { "op": "finish" }
  ],
  "secrets": []
}
