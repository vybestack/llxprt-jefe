{
  "schema": 1,
  "name": "agent-version-selector",
  "platform": "linux",
  "terminal": {
    "cols": 120,
    "rows": 36
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "repo",
        "mode": 493
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n"
        },
        "mode": 384
      },
      {
        "path": "config/state.json",
        "content": {
          "utf8": "{\n  \"state_schema\": 2,\n  \"revision\": 1,\n  \"repositories\": [\n    {\n      \"id\": \"repo\",\n      \"location\": {\n        \"local_path\": \"${workspace}/repo\"\n      },\n      \"display_name\": \"Repo\",\n      \"agent_defaults\": {\n        \"type_id\": \"core.llxprt\",\n        \"values\": {}\n      }\n    }\n  ],\n  \"agents\": [],\n  \"selection\": {\n    \"repository_id\": \"repo\",\n    \"agent_id\": null,\n    \"screen_id\": \"core.dashboard\"\n  },\n  \"last_selected_agent_by_repo\": {},\n  \"preferences\": {\n    \"hide_idle_repositories\": false,\n    \"pane_focus\": \"agents\",\n    \"terminal_focused\": false,\n    \"repository_preferences\": {}\n  },\n  \"dormant_records\": []\n}\n"
        },
        "mode": 384
      }
    ],
    "env": [
      {
        "name": "TERM",
        "value": "xterm-256color"
      }
    ]
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [
        {
          "name": "JEFE_PACKAGE_CACHE_DIR",
          "value": "${workspace}/package-cache"
        },
        {
          "name": "ISSUE382_CLAUDE_WITNESS",
          "value": "${workspace}/claude-launch.txt"
        }
      ],
      "cwd": "repo"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Agent Types",
      "timeout_ms": 30000
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Claude Code  Installed, enabled  [Create enabled]",
      "timeout_ms": 30000
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "> Claude Code",
      "timeout_ms": 30000
    },
    {
      "op": "key",
      "key": "enter",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "New Agent",
      "timeout_ms": 30000
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "> Permission Mode: [▏]",
      "timeout_ms": 30000
    },
    {
      "op": "text",
      "text": "acceptEdits"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Permission Mode: [acceptEdits▏]",
      "timeout_ms": 30000
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "> Version Selector: [▏]",
      "timeout_ms": 30000
    },
    {
      "op": "text",
      "text": "2.1.212"
    },
    {
      "op": "key",
      "key": "tab",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "tab",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "> [Create enabled]",
      "timeout_ms": 30000
    },
    {
      "op": "key",
      "key": "enter",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "F12 unfocus",
      "timeout_ms": 30000
    },
    {
      "op": "assert-file",
      "file": {
        "path": "npm-argv.txt",
        "exists": true,
        "content": {
          "utf8": "install\n"
        }
      }
    },
    {
      "op": "assert-file",
      "file": {
        "path": "claude-launch.txt",
        "exists": true,
        "content": {
          "utf8": "--permission-mode acceptEdits\n"
        }
      }
    },
    {
      "op": "assert-file",
      "file": {
        "path": "package-cache/2c31c4a8f1b7cf9d36a1616ec1ab9a61977d173917b218b4cf64cd9d3371751d/.jefe-installed",
        "exists": true,
        "content": {
          "utf8": "@anthropic-ai/claude-code\nclaude\n2.1.212\n"
        }
      }
    },
    {
      "op": "assert-file",
      "file": {
        "path": "package-cache/2c31c4a8f1b7cf9d36a1616ec1ab9a61977d173917b218b4cf64cd9d3371751d/package.json",
        "exists": true,
        "content": {
          "utf8": "{\n  \"name\": \"jefe-package-cache\",\n  \"version\": \"0.0.0\",\n  \"private\": true,\n  \"dependencies\": {\n    \"@anthropic-ai/claude-code\": \"2.1.212\"\n  }\n}\n"
        }
      }
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
