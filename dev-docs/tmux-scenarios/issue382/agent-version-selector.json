{
  "schema": 1,
  "name": "agent-version-selector",
  "platform": "linux",
  "terminal": { "cols": 120, "rows": 36 },
  "workspace": {
    "mode": 448,
    "dirs": [
      { "path": "bin", "mode": 493 },
      { "path": "config", "mode": 448 },
      { "path": "repo", "mode": 493 }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n[[repositories]]\nid = \"repo\"\nname = \"Repo\"\nslug = \"repo\"\nbase_dir = \"${workspace}/repo\"\n"
        },
        "mode": 384
      }
    ],
    "env": [
      { "name": "PATH", "value": "${workspace}/bin:/usr/bin:/bin" },
      { "name": "TERM", "value": "xterm-256color" }
    ]
  },
  "steps": [
    {
      "op": "capture",
      "name": "claude",
      "path": "bin/claude",
      "behavior": {
        "stdout": "2.1.212 (Claude Code)\n",
        "stderr": "",
        "exit_code": 0,
        "stdin_limit": 0,
        "hang": false,
        "spawn_child_hang": false
      }
    },
    {
      "op": "launch",
      "argv": ["jefe", "--config", "${workspace}/config"],
      "env": [],
      "cwd": "repo"
    },
    { "op": "wait", "source": "frame", "literal": "Agent Types", "timeout_ms": 15000 },
    { "op": "wait", "source": "frame", "literal": "> Claude Code", "timeout_ms": 15000 },
    { "op": "key", "key": "enter", "modifiers": [] },
    { "op": "wait", "source": "frame", "literal": "New Agent", "timeout_ms": 15000 },
    {
      "op": "assert-frame",
      "contains": [
        "Claude Code",
        "Version Selector: []",
        "Prompt: []",
        "[Create disabled]"
      ],
      "absent": ["npm exec", "uvx --from", "Package Runner"]
    },
    { "op": "finish" }
  ],
  "secrets": []
}
