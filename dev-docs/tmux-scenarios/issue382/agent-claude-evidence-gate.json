{
  "schema": 1,
  "name": "agent-claude-evidence-gate",
  "platform": "macos",
  "terminal": {
    "cols": 120,
    "rows": 36
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "repo",
        "mode": 493
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n"
        },
        "mode": 384
      }
    ],
    "env": [
      {
        "name": "TERM",
        "value": "xterm-256color"
      }
    ]
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "repo"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Agent Types",
      "timeout_ms": 15000
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Claude Code  Not found, enabled  [Create disabled]",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "Claude Code  Not found, enabled  [Create disabled]",
        "no executable candidate resolved"
      ],
      "absent": [
        "Claude Code  Installed",
        "Claude Code  Probe error",
        "Claude Code  Incompatible"
      ]
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
