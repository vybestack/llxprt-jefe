{
  "schema": 1,
  "name": "agent-claude-evidence-gate",
  "platform": "linux",
  "terminal": { "cols": 120, "rows": 36 },
  "workspace": {
    "mode": 448,
    "dirs": [
      { "path": "bin", "mode": 493 },
      { "path": "config", "mode": 448 },
      { "path": "repo", "mode": 493 }
    ],
    "files": [
      {
        "path": "bin/llxprt",
        "content": { "utf8": "#!/bin/sh\nprintf '0.10.0-nightly.260720.d69bda66a\\n'\n" },
        "mode": 493
      },
      {
        "path": "bin/codex",
        "content": { "utf8": "#!/bin/sh\nprintf 'codex-cli 0.142.0\\n'\n" },
        "mode": 493
      },
      {
        "path": "bin/code-puppy",
        "content": { "utf8": "#!/bin/sh\nprintf '0.0.634\\n'\n" },
        "mode": 493
      },
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n[[repositories]]\nid = \"repo\"\nname = \"Repo\"\nslug = \"repo\"\nbase_dir = \"${workspace}/repo\"\n"
        },
        "mode": 384
      }
    ],
    "env": [
      { "name": "PATH", "value": "${workspace}/bin:/usr/bin:/bin" },
      { "name": "TERM", "value": "xterm-256color" }
    ]
  },
  "steps": [
    { "op": "launch", "argv": ["jefe", "--config", "${workspace}/config"], "env": [], "cwd": "repo" },
    { "op": "wait", "source": "frame", "literal": "Agent Types", "timeout_ms": 15000 },
    { "op": "wait", "source": "frame", "literal": "Claude", "timeout_ms": 15000 },
    {
      "op": "capture",
      "name": "claude",
      "path": "bin/claude",
      "behavior": {
        "stdout": "",
        "stderr": "",
        "exit_code": 127,
        "stdin_limit": 0,
        "hang": false,
        "spawn_child_hang": false
      }
    },
    {
      "op": "assert-frame",
      "contains": ["Claude", "Not found", "disabled"],
      "absent": ["Installed", "enabled", "probe"]
    },
    { "op": "finish" }
  ],
  "secrets": []
}
