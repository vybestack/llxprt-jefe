{
  "schema": 1,
  "name": "code-puppy-chord-passthrough",
  "platform": "macos",
  "terminal": {
    "cols": 130,
    "rows": 40
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "work",
        "mode": 448
      },
      {
        "path": "work/fixture-repo-alpha",
        "mode": 448
      },
      {
        "path": "work/fixture-repo-beta",
        "mode": 448
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n"
        },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt Jefe",
      "timeout_ms": 12000
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Code Puppy  Installed",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "f7",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Terminal Manager",
      "timeout_ms": 12000
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "No shells",
      "timeout_ms": 12000
    },
    {
      "op": "key",
      "key": "escape",
      "modifiers": []
