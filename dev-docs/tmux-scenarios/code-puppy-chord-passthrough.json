{
  "schema": 1,
  "name": "code-puppy-chord-passthrough",
  "platform": "macos",
  "terminal": {
    "cols": 130,
    "rows": 40
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "work",
        "mode": 448
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n"
        },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt Jefe",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "F12 to unfocus"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "t",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "F12 to unfocus",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "C-x",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "C-b",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "C-x",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "C-x",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "C-c",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "F12",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "F12/t to focus",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": []
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
