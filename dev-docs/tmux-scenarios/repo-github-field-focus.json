{
  "schema": 1,
  "name": "repo-github-field-focus",
  "platform": "macos",
  "terminal": {
    "cols": 120,
    "rows": 40
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "work",
        "mode": 448
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n"
        },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt Jefe",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "n",
      "modifiers": ["shift"]
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "New Repository",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "GitHub Repo"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "tab",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Base Dir         [\u258f]",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "tab",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "tab",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "tab",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "tab",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "GitHub Repo     [\u258f]",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "a",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "c",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "m",
      "modifiers": []
    },
    {
