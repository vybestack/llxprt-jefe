{
  "schema": 1,
  "name": "llxprt-launch-options",
  "platform": "macos",
  "terminal": {
    "cols": 120,
    "rows": 40
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "work",
        "mode": 448
      },
      {
        "path": "work/repo",
        "mode": 448
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n"
        },
        "mode": 384
      },
      {
        "path": "config/state.json",
        "content": {
          "utf8": "{\n  \"schema_version\": 1,\n  \"repositories\": [\n    {\n      \"id\": \"repo-519\",\n      \"name\": \"Issue 519\",\n      \"slug\": \"issue-519\",\n      \"base_dir\": \"repo\",\n      \"default_profile\": \"\",\n      \"default_code_puppy_model\": \"\",\n      \"github_repo\": \"\",\n      \"remote\": {\n        \"enabled\": false,\n        \"host\": \"\",\n        \"user\": \"\",\n        \"port\": null\n      },\n      \"issue_base_prompt\": \"\",\n      \"default_agent_kind\": \"llxprt\",\n      \"agent_ids\": []\n    }\n  ],\n  \"agents\": [],\n  \"selected_repository_index\": 0,\n  \"selected_agent_index\": null,\n  \"hide_idle_repositories\": false,\n  \"last_selected_agent_by_repo\": [],\n  \"pane_focus\": \"\",\n  \"terminal_focused\": false,\n  \"user_preferences\": {}\n}\n"
        },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt Jefe",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "n",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "New Agent",
      "timeout_ms": 15000
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Mode Flags: --yolo",
      "timeout_ms": 15000
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Pass --continue: true",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "Agent Runtime: core.llxprt",
        "Mode Flags: --yolo",
        "Pass --continue: true"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "escape",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": [
        "control"
      ]
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
