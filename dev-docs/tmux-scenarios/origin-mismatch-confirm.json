{
  "schema": 1,
  "name": "origin-mismatch-confirm",
  "platform": "macos",
  "terminal": {
    "cols": 120,
    "rows": 36
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "work",
        "mode": 448
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n"
        },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt Jefe",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "i",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Issues",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "Enter",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "S",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Send to Agent",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "Enter",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Wrong Repository",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "Replace it with a fresh clone?"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "Escape",
      "modifiers": []
    },
    {
      "op": "assert-frame",
      "contains": [],
      "absent": [
        "Wrong Repository"
      ]
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": []
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
