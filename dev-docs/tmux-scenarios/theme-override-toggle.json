{
  "schema": 1,
  "name": "theme-override-toggle",
  "platform": "macos",
  "terminal": {
    "cols": 100,
    "rows": 32
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "work",
        "mode": 448
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n"
        },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt Jefe",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": ",",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Appearance",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Apply theme to agent",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "Apply theme to agent",
        "[ ]"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "tab",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "space",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "[x]",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "[x]",
        "s save"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "s",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Saved",
      "timeout_ms": 15000
    },
    {
      "op": "assert-file",
      "file": {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n[appearance]\noverride_agent_theme = true\n"
        }
      }
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt Jefe",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": [
        "control"
      ]
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
