{
  "schema": 1,
  "name": "theme-override-toggle",
  "platform": "macos",
  "terminal": {
    "cols": 100,
    "rows": 32
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "work",
        "mode": 448
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n"
        },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt Jefe",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "f9",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Select Theme",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "Apply theme to agent"
      ],
      "absent": []
    },
    {
      "op": "assert-frame",
      "contains": [
        "[ ]"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "tab",
      "modifiers": []
    },
    {
      "op": "assert-frame",
      "contains": [
        "[x]"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "enter",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt Jefe",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": []
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
