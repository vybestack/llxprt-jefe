{
  "schema": 1,
  "name": "windows-multi-agent-lifecycle",
  "platform": "linux",
  "terminal": {
    "cols": 130,
    "rows": 40
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "work",
        "mode": 448
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n"
        },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt Jefe",
      "timeout_ms": 15000
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt \u03a9 One",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "Puppy \u03a9 Two"
      ],
      "absent": []
    },
    {
      "op": "assert-frame",
      "contains": [
        "LLxprt Three"
      ],
      "absent": []
    },
    {
      "op": "assert-frame",
      "contains": [
        "Puppy Four"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "M-1",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLXPRT_ONE_READY",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "M-2",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "PUPPY_TWO_READY",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "M-3",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLXPRT_THREE_READY",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "M-4",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "PUPPY_FOUR_READY",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "C-k",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Kill agent",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "Tab",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "Enter",
      "modifiers": []
    },
    {
      "op": "assert-frame",
      "contains": [],
      "absent": [
        "Kill agent"
      ]
    },
    {
      "op": "assert-frame",
      "contains": [],
      "absent": [
        "Puppy Four"
      ]
    },
    {
      "op": "assert-frame",
      "contains": [
        "LLxprt \u03a9 One"
      ],
      "absent": []
    },
    {
      "op": "assert-frame",
      "contains": [
        "Puppy \u03a9 Two"
      ],
      "absent": []
    },
    {
      "op": "assert-frame",
      "contains": [
        "LLxprt Three"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "C-q",
      "modifiers": []
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
