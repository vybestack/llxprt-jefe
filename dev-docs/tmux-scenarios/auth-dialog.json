{
  "schema": 1,
  "name": "auth-dialog",
  "platform": "macos",
  "terminal": {
    "cols": 100,
    "rows": 32
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "work",
        "mode": 448
      },
      {
        "path": "work/repo",
        "mode": 448
      },
      {
        "path": "private",
        "mode": 448
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n"
        },
        "mode": 384
      },
      {
        "path": "config/state.json",
        "content": {
          "utf8": "{\n  \"schema_version\": 1,\n  \"repositories\": [\n    {\n      \"id\": \"fixture-repo\",\n      \"name\": \"LLxprt Jefe\",\n      \"slug\": \"llxprt-jefe\",\n      \"base_dir\": \"repo\",\n      \"default_profile\": \"\",\n      \"default_code_puppy_model\": \"\",\n      \"github_repo\": \"vybestack/llxprt-jefe\",\n      \"remote\": {\n        \"enabled\": false,\n        \"host\": \"\",\n        \"user\": \"\",\n        \"port\": null\n      },\n      \"issue_base_prompt\": \"\",\n      \"default_agent_kind\": \"llxprt\",\n      \"agent_ids\": []\n    }\n  ],\n  \"agents\": [],\n  \"selected_repository_index\": 0,\n  \"selected_agent_index\": null,\n  \"hide_idle_repositories\": false,\n  \"last_selected_agent_by_repo\": [],\n  \"pane_focus\": \"\",\n  \"terminal_focused\": false,\n  \"user_preferences\": {}\n}\n"
        },
        "mode": 384
      },
      {
        "path": "private/gh-audit.log",
        "content": {
          "utf8": ""
        },
        "mode": 384
      },
      {
        "path": "private/gh-state",
        "content": {
          "utf8": "open\n"
        },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [
        {
          "name": "HARNESS_GH_AUDIT",
          "value": "${workspace}/private/gh-audit.log"
        },
        {
          "name": "HARNESS_GH_STATE",
          "value": "${workspace}/private/gh-state"
        },
        {
          "name": "HARNESS_GH_MODE",
          "value": "unauthenticated"
        }
      ],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt Jefe",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "i",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Authenticate with GitHub",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "Authenticate with GitHub"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "escape",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": []
    },
    {
      "op": "assert-file",
      "file": {
        "path": "private/gh-audit.log",
        "content": {
          "utf8": "ACCEPTED unauthenticated-request\nACCEPTED auth-login\n"
        }
      }
    },
    {
      "op": "assert-file",
      "file": {
        "path": "private/gh-audit.log.rejected",
        "exists": false
      }
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
