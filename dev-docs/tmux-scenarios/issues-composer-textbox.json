{
  "config": {
    "cols": 160,
    "rows": 40,
    "history_limit": 4000,
    "initial_wait_ms": 100,
    "wait_timeout_ms": 15000,
    "assert_mode": "strict"
  },
  "steps": [
    { "waitFor": "LLxprt Jefe" },
    { "key": "i" },
    { "waitFor": "No issues found" },
    { "key": "n" },
    { "waitFor": "New Issue" },
    { "type": "row-one-visible" },
    { "key": "Enter" },
    { "type": "row-two-visible" },
    { "key": "Enter" },
    { "type": "row-three-visible" },
    { "key": "Enter" },
    { "type": "row-four-visible" },
    { "key": "Enter" },
    { "type": "row-five-visible" },
    { "key": "Enter" },
    { "type": "row-six-visible" },
    { "key": "Enter" },
    { "type": "row-seven-visible" },
    { "key": "Enter" },
    { "type": "row-eight-visible" },
    { "waitFor": "row-eight-visible" },
    { "expect": "row-one-visible" },
    { "expect": "row-eight-visible" },
    { "capture": "issues-new-composer-expanded" },
    { "key": "Escape" },
    { "key": "C-q" },
    { "waitForExit": 3000 }
  ]
}
