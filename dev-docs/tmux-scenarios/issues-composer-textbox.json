{
  "schema": 1,
  "name": "issues-composer-textbox",
  "platform": "macos",
  "terminal": {
    "cols": 160,
    "rows": 40
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "work",
        "mode": 448
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n"
        },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt Jefe",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "i",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "No issues found",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "n",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "New Issue",
      "timeout_ms": 15000
    },
    {
      "op": "text",
      "text": "row-one-visible"
    },
    {
      "op": "key",
      "key": "Enter",
      "modifiers": []
    },
    {
      "op": "text",
      "text": "row-two-visible"
    },
    {
      "op": "key",
      "key": "Enter",
      "modifiers": []
    },
    {
      "op": "text",
      "text": "row-three-visible"
    },
    {
      "op": "key",
      "key": "Enter",
      "modifiers": []
    },
    {
      "op": "text",
      "text": "row-four-visible"
    },
    {
      "op": "key",
      "key": "Enter",
      "modifiers": []
    },
    {
      "op": "text",
      "text": "row-five-visible"
    },
    {
      "op": "key",
      "key": "Enter",
      "modifiers": []
    },
    {
      "op": "text",
      "text": "row-six-visible"
    },
    {
      "op": "key",
      "key": "Enter",
      "modifiers": []
    },
    {
      "op": "text",
      "text": "row-seven-visible"
    },
    {
      "op": "key",
      "key": "Enter",
      "modifiers": []
    },
    {
      "op": "text",
      "text": "row-eight-visible"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "row-eight-visible",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "row-one-visible"
      ],
      "absent": []
    },
    {
      "op": "assert-frame",
      "contains": [
        "row-eight-visible"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "Enter",
      "modifiers": []
    },
    {
      "op": "text",
      "text": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\u754ccell-tail"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "\u2502   \u2502 \u754ccell-tail",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "\u2502   \u2502 \u754ccell-tail"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "Escape",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "C-q",
      "modifiers": []
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
