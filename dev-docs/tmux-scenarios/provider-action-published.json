{
  "schema": 1,
  "name": "provider-action-published",
  "platform": "macos",
  "terminal": {
    "cols": 120,
    "rows": 50
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "config/plugins",
        "mode": 448
      },
      {
        "path": "config/plugins/installed",
        "mode": 448
      },
      {
        "path": "config/plugins/installed/vendor.deploy",
        "mode": 448
      },
      {
        "path": "config/plugins/installed/vendor.deploy/1.0.0",
        "mode": 448
      },
      {
        "path": "config/plugins/installed/vendor.deploy/1.0.0/bin",
        "mode": 448
      },
      {
        "path": "work",
        "mode": 448
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n\n[plugins.\"vendor.deploy\"]\nenabled = true\nversion = \"1.0.0\"\n"
        },
        "mode": 384
      },
      {
        "path": "config/plugins/installed/vendor.deploy/1.0.0/plugin.json",
        "content": {
          "utf8": "{\n  \"manifest_schema\": 1,\n  \"id\": \"vendor.deploy\",\n  \"version\": \"1.0.0\",\n  \"display_name\": \"Vendor Deploy\",\n  \"host_api\": { \"minimum\": \"0.0.1\", \"maximum\": \"99.0.0\" },\n  \"protocol\": 1,\n  \"provider\": { \"mode\": \"one-shot\", \"binaries\": { \"aarch64-apple-darwin\": \"bin/deploy\" } },\n  \"actions\": [\n    {\n      \"id\": \"vendor.deploy.ship\",\n      \"label\": \"Ship release\",\n      \"description\": \"Ship the selected release through the vendor provider\",\n      \"category\": \"vendor.deploy\",\n      \"contexts\": [\"dashboard\"],\n      \"arguments\": [],\n      \"timeout_seconds\": 60,\n      \"destructive\": false,\n      \"confirmation\": \"none\",\n      \"handler\": \"ship\",\n      \"allowed_outcomes\": [\"notice\"]\n    }\n  ],\n  \"panels\": [],\n  \"routes\": [],\n  \"screens\": []\n}\n"
        },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [
        {
          "name": "JEFE_SOCKET_PATH",
          "value": "${workspace}/s"
        },
        {
          "name": "JEFE_LOG_FILE",
          "value": "${workspace}/jefe.log"
        }
      ],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Agent Types",
      "timeout_ms": 20000
    },
    {
      "op": "key",
      "key": "h",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Help - Keyboard Shortcuts",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "end",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Packages:",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "Ship release"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "escape",
      "modifiers": []
    },
    {
      "op": "assert-frame",
      "contains": [],
      "absent": [
        "Help - Keyboard Shortcuts"
      ]
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": [
        "control"
      ]
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
