{
  "schema": 1,
  "name": "send-to-agent-details",
  "platform": "macos",
  "terminal": {
    "cols": 160,
    "rows": 40
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "work",
        "mode": 448
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n"
        },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt Jefe",
      "timeout_ms": 15000
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "alpha",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "owner/repo-230 @ main *"
      ],
      "absent": []
    },
    {
      "op": "assert-frame",
      "contains": [
        "owner/repo-230 @ feature"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "i",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Issues",
      "timeout_ms": 15000
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "#230",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "enter",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Agent chooser identity and worktree status",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "s",
      "modifiers": ["shift"]
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Send to Agent",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "alpha [LLxprt] profile: ops"
      ],
      "absent": []
    },
    {
      "op": "assert-frame",
      "contains": [
        "beta [Code Puppy] model: (default)"
      ],
      "absent": []
    },
    {
      "op": "assert-frame",
      "contains": [
        "profile: ops  @ main *"
      ],
      "absent": []
    },
    {
      "op": "assert-frame",
      "contains": [
        "model: (default)  @ feature"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "escape",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": ["control"]
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
