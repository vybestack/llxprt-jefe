{
  "schema": 1,
  "name": "windows-agent-working-directory",
  "platform": "linux",
  "terminal": {
    "cols": 140,
    "rows": 45
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "work",
        "mode": 448
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n"
        },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt Jefe",
      "timeout_ms": 30000
    },
    {
      "op": "key",
      "key": "5",
      "modifiers": ["alt"]
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "branch-3",
      "timeout_ms": 30000
    },
    {
      "op": "key",
      "key": "l",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "F12 unfocus",
      "timeout_ms": 30000
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "branch-3",
      "timeout_ms": 30000
    },
    {
      "op": "key",
      "key": "c",
      "modifiers": ["control"]
    },
    {
      "op": "key",
      "key": "f12",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": ["control"]
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
