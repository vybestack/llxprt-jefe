{
  "schema": 1,
  "name": "config-ambiguity",
  "platform": "macos",
  "terminal": { "cols": 100, "rows": 30 },
  "workspace": {
    "mode": 448,
    "dirs": [
      { "path": "jefe-state", "mode": 448 },
      { "path": "legacy-data/jefe", "mode": 448 }
    ],
    "files": [
      {
        "path": "jefe-state/state.json",
        "content": { "utf8": "{\"state_schema\":2}" },
        "mode": 384
      },
      {
        "path": "legacy-data/jefe/state.json",
        "content": { "utf8": "{\"schema_version\":1}" },
        "mode": 384
      }
    ],
    "env": [
      { "name": "XDG_DATA_HOME", "value": "${workspace}/legacy-data" }
    ]
  },
  "steps": [
    {
      "op": "launch",
      "argv": ["jefe", "config", "path"],
      "env": [],
      "cwd": "."
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "CFG-E001",
      "timeout_ms": 15000
    },
    {
      "op": "assert-file",
      "file": {
        "path": "jefe-state/state.json",
        "content": { "utf8": "{\"state_schema\":2}" }
      }
    },
    {
      "op": "assert-file",
      "file": {
        "path": "legacy-data/jefe/state.json",
        "content": { "utf8": "{\"schema_version\":1}" }
      }
    },
    { "op": "finish" }
  ],
  "secrets": []
}
