{
  "schema": 1,
  "name": "settings-v1-lossless",
  "platform": "macos",
  "terminal": { "cols": 100, "rows": 30 },
  "workspace": {
    "mode": 448,
    "dirs": [{ "path": "config", "mode": 448 }],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "# preserve this heading\nschema_version = 1\ntheme = 'green-screen' # preserve quoting\noverride_agent_theme = true\n\n[future.owner]\nquoted = \"untouched\"\n"
        },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": ["jefe", "config", "validate", "--config", "${workspace}/config"],
      "env": [],
      "cwd": "."
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "green-screen",
      "timeout_ms": 15000
    },
    {
      "op": "assert-file",
      "file": {
        "path": "config/settings.toml",
        "content": {
          "utf8": "# preserve this heading\nschema_version = 1\ntheme = 'green-screen' # preserve quoting\noverride_agent_theme = true\n\n[future.owner]\nquoted = \"untouched\"\n"
        }
      }
    },
    { "op": "finish" }
  ],
  "secrets": []
}
