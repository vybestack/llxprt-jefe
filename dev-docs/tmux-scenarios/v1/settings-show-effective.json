{
  "schema": 1,
  "name": "settings-show-effective",
  "platform": "macos",
  "terminal": { "cols": 110, "rows": 34 },
  "workspace": {
    "mode": 448,
    "dirs": [{ "path": "config", "mode": 448 }, { "path": "work", "mode": 448 }],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n\n[appearance]\ntheme = \"green-screen\"\noverride_agent_theme = true\n\n[agents.\"core.llxprt\"]\nenabled = true\nrepository_defaults = { profile = \"review\", credential = { secret_ref = \"github.token\" } }\n\n[agents.\"future.agent\"]\nenabled = true\nrepository_defaults = { credential = \"dormant-private\" }\n"
        },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "capture",
      "name": "gh",
      "path": "bin/gh",
      "behavior": {
        "stdout": "provider must not run\n",
        "stderr": "",
        "exit_code": 0,
        "stdin_limit": 0,
        "hang": true,
        "spawn_child_hang": true
      }
    },
    {
      "op": "launch",
      "argv": ["jefe", "config", "show-effective", "--provenance", "--config", "${workspace}/config"],
      "env": [],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "<dormant-redacted>",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": ["settings_schema = 2", "core.llxprt", "credential = \"<redacted>\"", "# provenance", "<dormant-redacted>"],
      "absent": ["github.token", "dormant-private", "provider must not run", "LLxprt Jefe", "tmux"]
    },
    {
      "op": "assert-file",
      "file": {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n\n[appearance]\ntheme = \"green-screen\"\noverride_agent_theme = true\n\n[agents.\"core.llxprt\"]\nenabled = true\nrepository_defaults = { profile = \"review\", credential = { secret_ref = \"github.token\" } }\n\n[agents.\"future.agent\"]\nenabled = true\nrepository_defaults = { credential = \"dormant-private\" }\n"
        }
      }
    },
    { "op": "finish" }
  ],
  "secrets": []
}
