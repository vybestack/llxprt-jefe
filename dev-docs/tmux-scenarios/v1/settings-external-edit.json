{
  "schema": 1,
  "name": "settings-external-edit",
  "platform": "macos",
  "terminal": { "cols": 120, "rows": 36 },
  "workspace": {
    "mode": 448,
    "dirs": [
      { "path": "config", "mode": 448 },
      { "path": "work", "mode": 448 }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": { "utf8": "settings_schema = 2\n[appearance]\ntheme = 'green-screen'\n" },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": ["jefe", "--config", "${workspace}/config"],
      "env": [],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt Jefe",
      "timeout_ms": 15000
    },
    { "op": "key", "key": ",", "modifiers": [] },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Diagnostics",
      "timeout_ms": 15000
    },
    { "op": "key", "key": "down", "modifiers": [] },
    { "op": "key", "key": "tab", "modifiers": [] },
    { "op": "key", "key": "down", "modifiers": [] },
    { "op": "key", "key": "enter", "modifiers": [] },
    {
      "op": "wait",
      "source": "frame",
      "literal": ">>Ayu Dark",
      "timeout_ms": 15000
    },
    {
      "op": "write",
      "file": {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n# somebody else was here\n[appearance]\ntheme = 'atom-one-dark'\n"
        },
        "mode": 384
      }
    },
    { "op": "key", "key": "s", "modifiers": [] },
    {
      "op": "wait",
      "source": "frame",
      "literal": "External edit detected",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": ["disk and draft preserved", ">>Reload", "Export", "Retry"],
      "absent": []
    },
    {
      "op": "assert-file",
      "file": {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n# somebody else was here\n[appearance]\ntheme = 'atom-one-dark'\n"
        }
      }
    },
    { "op": "key", "key": "enter", "modifiers": [] },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Reload from disk and lose unsaved changes?",
      "timeout_ms": 15000
    },
    { "op": "key", "key": "enter", "modifiers": [] },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Reloaded from disk",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": ["Reloaded from disk"],
      "absent": ["External edit detected"]
    },
    {
      "op": "assert-file",
      "file": {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n# somebody else was here\n[appearance]\ntheme = 'atom-one-dark'\n"
        }
      }
    },
    { "op": "key", "key": "q", "modifiers": [] },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt Jefe",
      "timeout_ms": 15000
    },
    { "op": "key", "key": "q", "modifiers": ["control"] },
    { "op": "finish" }
  ],
  "secrets": []
}
