{
  "schema": 1,
  "name": "panic-capture-errors",
  "platform": "macos",
  "terminal": { "cols": 100, "rows": 30 },
  "workspace": {
    "mode": 448,
    "dirs": [{ "path": "work", "mode": 448 }],
    "files": [],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": ["jefe-harness-probe"],
      "env": [],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "PROBE READY",
      "timeout_ms": 15000
    },
    { "op": "text", "text": "panic-errors\n" },
    {
      "op": "wait",
      "source": "frame",
      "literal": "PANIC ERRORS READY",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "STATUS ERROR TITLE <none>",
        "Source: Panic",
        "issue-496-ui-panic",
        "PANIC ERRORS READY"
      ],
      "absent": ["thread '", "panicked at", "ERR: issue-496-ui-panic"]
    },
    { "op": "finish" }
  ],
  "secrets": []
}
