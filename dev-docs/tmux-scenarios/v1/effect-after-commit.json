{
  "schema": 1,
  "name": "effect-after-commit",
  "platform": "macos",
  "terminal": {
    "cols": 120,
    "rows": 36
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "work",
        "mode": 448
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n"
        },
        "mode": 384
      },
      {
        "path": "config/state.json",
        "content": {
          "utf8": "{\n  \"schema_version\": 1,\n  \"repositories\": [{\n    \"id\": \"repo\",\n    \"name\": \"Repo\",\n    \"slug\": \"repo\",\n    \"base_dir\": \"/srv/project\",\n    \"default_profile\": \"\",\n    \"remote\": {\n      \"enabled\": true,\n      \"login_user\": \"dev\",\n      \"host\": \"example.com\",\n      \"port\": 2222,\n      \"run_as_user\": \"runner\"\n    },\n    \"agent_ids\": [\"agent\"]\n  }],\n  \"agents\": [{\n    \"id\": \"agent\",\n    \"display_id\": \"A1\",\n    \"repository_id\": \"repo\",\n    \"name\": \"Doomed\",\n    \"description\": \"\",\n    \"work_dir\": \"/srv/project/work\",\n    \"profile\": \"\",\n    \"mode_flags\": [],\n    \"pass_continue\": true,\n    \"sandbox_enabled\": false,\n    \"sandbox_engine\": \"podman\",\n    \"sandbox_flags\": \"\",\n    \"status\": \"Queued\",\n    \"runtime_binding\": null\n  }],\n  \"selected_repository_index\": 0,\n  \"selected_agent_index\": 0\n}\n"
        },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt Jefe",
      "timeout_ms": 15000
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Doomed",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "k",
      "modifiers": [
        "control"
      ]
    },
    {
      "op": "key",
      "key": "e",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Runtime effect failed",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "Runtime effect failed",
        "session not found"
      ],
      "absent": []
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
