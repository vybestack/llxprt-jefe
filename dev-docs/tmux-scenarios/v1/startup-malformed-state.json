{
  "schema": 1,
  "name": "startup-malformed-state",
  "platform": "macos",
  "terminal": { "cols": 120, "rows": 36 },
  "workspace": {
    "mode": 448,
    "dirs": [{ "path": "config", "mode": 448 }, { "path": "work", "mode": 448 }],
    "files": [
      {
        "path": "config/settings.toml",
        "content": { "utf8": "settings_schema = 2\n" },
        "mode": 384
      },
      {
        "path": "config/state.json",
        "content": { "utf8": "{ malformed state bytes\n" },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": ["jefe", "--config", "${workspace}/config"],
      "env": [],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "stdout",
      "literal": "CFG-E103",
      "timeout_ms": 15000
    },
    {
      "op": "wait",
      "source": "stdout",
      "literal": "jefe config validate --config",
      "timeout_ms": 15000
    },
    {
      "op": "wait",
      "source": "stdout",
      "literal": "jefe config migrate-state --config",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": ["jefe config validate --config"],
      "absent": ["LLxprt Jefe", "Repositories"]
    },
    {
      "op": "assert-file",
      "file": {
        "path": "config/state.json",
        "content": { "utf8": "{ malformed state bytes\n" }
      }
    },
    { "op": "finish" }
  ],
  "secrets": []
}
