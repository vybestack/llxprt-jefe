{
  "schema": 1,
  "name": "workbench-screen",
  "platform": "macos",
  "terminal": {
    "cols": 120,
    "rows": 36
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "work",
        "mode": 448
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "schema_version = 1\ntheme = 'green-screen'\n"
        },
        "mode": 384
      },
      {
        "path": "config/state.json",
        "content": {
          "utf8": "{\n  \"state_schema\": 2,\n  \"revision\": 1,\n  \"repositories\": [\n    {\n      \"id\": \"repo.wb\",\n      \"location\": {\n        \"local_path\": \".\"\n      },\n      \"display_name\": \"WBFix\",\n      \"agent_defaults\": {\n        \"type_id\": \"core.llxprt\",\n        \"values\": {\n          \"slug\": {\n            \"type\": \"string\",\n            \"value\": \"workbench\"\n          }\n        }\n      }\n    }\n  ],\n  \"agents\": [],\n  \"selection\": {\n    \"repository_id\": \"repo.wb\",\n    \"agent_id\": null,\n    \"screen_id\": \"core.dashboard\"\n  },\n  \"last_selected_agent_by_repo\": {},\n  \"preferences\": {\n    \"hide_idle_repositories\": false,\n    \"pane_focus\": \"agents\",\n    \"terminal_focused\": false,\n    \"repository_preferences\": {}\n  },\n  \"dormant_records\": []\n}\n"
        },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [
        {
          "name": "JEFE_SOCKET_PATH",
          "value": "${workspace}/s"
        }
      ],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "WBFix",
      "timeout_ms": 30000
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "s",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "STATUS",
      "timeout_ms": 30000
    },
    {
      "op": "assert-frame",
      "contains": [
        "STATUS",
        "Needs you",
        "Working",
        "Ready",
        "Stale"
      ],
      "absent": []
    },
    {
      "op": "assert-frame",
      "contains": [
        "No agents are running."
      ],
      "absent": []
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}