{
  "schema": 1,
  "name": "settings-dirty-back",
  "platform": "macos",
  "terminal": { "cols": 120, "rows": 36 },
  "workspace": {
    "mode": 448,
    "dirs": [
      { "path": "config", "mode": 448 },
      { "path": "work", "mode": 448 }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": { "utf8": "settings_schema = 2\n[appearance]\ntheme = 'green-screen'\n" },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": ["jefe", "--config", "${workspace}/config"],
      "env": [],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt Jefe",
      "timeout_ms": 15000
    },
    { "op": "key", "key": ",", "modifiers": [] },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Diagnostics",
      "timeout_ms": 15000
    },
    { "op": "key", "key": "down", "modifiers": [] },
    { "op": "key", "key": "tab", "modifiers": [] },
    { "op": "key", "key": "down", "modifiers": [] },
    { "op": "key", "key": "enter", "modifiers": [] },
    {
      "op": "wait",
      "source": "frame",
      "literal": ">>Ayu Dark",
      "timeout_ms": 15000
    },
    { "op": "key", "key": "q", "modifiers": [] },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Save changes?",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [">>Save", "Discard", "Cancel", "quit"],
      "absent": []
    },
    { "op": "key", "key": "escape", "modifiers": [] },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Kept your changes",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": ["Kept your changes", ">>Ayu Dark", "Apply theme to agent"],
      "absent": ["Save changes?"]
    },
    { "op": "key", "key": "up", "modifiers": [] },
    {
      "op": "wait",
      "source": "frame",
      "literal": ">>Green Screen",
      "timeout_ms": 15000
    },
    { "op": "key", "key": "down", "modifiers": [] },
    {
      "op": "wait",
      "source": "frame",
      "literal": ">>Ayu Dark",
      "timeout_ms": 15000
    },
    { "op": "key", "key": "q", "modifiers": [] },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Save changes?",
      "timeout_ms": 15000
    },
    { "op": "key", "key": "tab", "modifiers": [] },
    {
      "op": "wait",
      "source": "frame",
      "literal": ">>Discard",
      "timeout_ms": 15000
    },
    { "op": "key", "key": "enter", "modifiers": [] },
    {
      "op": "wait",
      "source": "frame",
      "literal": "LLxprt Jefe",
      "timeout_ms": 15000
    },
    {
      "op": "assert-file",
      "file": {
        "path": "config/settings.toml",
        "content": { "utf8": "settings_schema = 2\n[appearance]\ntheme = 'green-screen'\n" }
      }
    },
    { "op": "key", "key": "q", "modifiers": ["control"] },
    { "op": "finish" }
  ],
  "secrets": []
}
