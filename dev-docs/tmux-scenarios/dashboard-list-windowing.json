{
  "schema": 1,
  "name": "dashboard-list-windowing",
  "platform": "macos",
  "terminal": {
    "cols": 100,
    "rows": 25
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "work",
        "mode": 448
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n"
        },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Repository 24",
      "timeout_ms": 30000
    },
    {
      "op": "assert-frame",
      "contains": [
        "Agent 24"
      ],
      "absent": []
    },
    {
      "op": "assert-frame",
      "contains": [
        "Repository 7"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "Tab",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "Up",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Agent 23",
      "timeout_ms": 30000
    },
    {
      "op": "key",
      "key": "C-q",
      "modifiers": []
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
