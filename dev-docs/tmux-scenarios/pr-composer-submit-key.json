{
  "schema": 1,
  "name": "pr-composer-submit-key",
  "platform": "macos",
  "terminal": {
    "cols": 120,
    "rows": 36
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "work",
        "mode": 448
      },
      {
        "path": "work/repo",
        "mode": 448
      },
      {
        "path": "private",
        "mode": 448
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n[keymap.\"prs.inline\"]\n\"prs.inline-submit\" = [\"F9\"]\n"
        },
        "mode": 384
      },
      {
        "path": "config/state.json",
        "content": {
          "utf8": "{\n  \"schema_version\": 1,\n  \"repositories\": [\n    {\n      \"id\": \"issue189-repo\",\n      \"name\": \"composer-submit-fixture\",\n      \"slug\": \"composer-submit-fixture\",\n      \"base_dir\": \"repo\",\n      \"default_profile\": \"\",\n      \"default_code_puppy_model\": \"\",\n      \"github_repo\": \"owner/review-sort-fixture\",\n      \"remote\": {\n        \"enabled\": false,\n        \"host\": \"\",\n        \"user\": \"\",\n        \"port\": null\n      },\n      \"issue_base_prompt\": \"\",\n      \"default_agent_kind\": \"llxprt\",\n      \"agent_ids\": []\n    }\n  ],\n  \"agents\": [],\n  \"selected_repository_index\": 0,\n  \"selected_agent_index\": null,\n  \"hide_idle_repositories\": false,\n  \"last_selected_agent_by_repo\": [],\n  \"pane_focus\": \"\",\n  \"terminal_focused\": false,\n  \"user_preferences\": {}\n}\n"
        },
        "mode": 384
      }
    ],
    "env": [
      {
        "name": "GH_SHIM_AUDIT",
        "value": "${workspace}/private/gh-audit.log"
      }
    ]
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Repositories",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "p",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Add newest-first review sorting",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "enter",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Reviews",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "c",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "F9 submit",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "F9 submit"
      ],
      "absent": [
        "Alt+Enter submit"
      ]
    },
    {
      "op": "text",
      "text": "PR body line one"
    },
    {
      "op": "key",
      "key": "enter",
      "modifiers": []
    },
    {
      "op": "text",
      "text": "PR body line two"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "PR body line two",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "PR body line one",
        "PR body line two"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "escape",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "escape",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": [
        "control"
      ]
    },
    {
      "op": "assert-file",
      "file": {
        "path": "private/gh-audit.log.accepted-pr-search"
      }
    },
    {
      "op": "assert-file",
      "file": {
        "path": "private/gh-audit.log.accepted-pr-view-detail"
      }
    },
    {
      "op": "assert-file",
      "file": {
        "path": "private/gh-audit.log.accepted-review-threads"
      }
    },
    {
      "op": "assert-file",
      "file": {
        "path": "private/gh-audit.log.rejected",
        "exists": false
      }
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
