          "utf8": "{\n  \"manifest_schema\": 1,\n  \"id\": \"vendor.deploy\",\n  \"version\": \"1.0.0\",\n  \"display_name\": \"Vendor Deploy\",\n  \"host_api\": { \"minimum\": \"0.0.1\", \"maximum\": \"99.0.0\" },\n  \"protocol\": 1,\n  \"provider\": { \"mode\": \"persistent\", \"binaries\": { \"aarch64-apple-darwin\": \"bin/deploy\", \"x86_64-unknown-linux-gnu\": \"bin/deploy\" } },\n  \"actions\": [\n    {\n      \"id\": \"vendor.deploy.ship\",\n      \"label\": \"Ship release\",\n      \"description\": \"Ship the selected release through the vendor provider\",\n      \"category\": \"vendor.deploy\",\n      \"contexts\": [\"dashboard\"],\n      \"arguments\": [],\n      \"timeout_seconds\": 60,\n      \"destructive\": false,\n      \"confirmation\": \"none\",\n      \"handler\": \"ship\",\n      \"allowed_outcomes\": [\"notice\"]\n    }\n  ],\n  \"panels\": [],\n  \"routes\": [],\n  \"screens\": []\n}\n"
        },
