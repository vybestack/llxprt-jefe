        "content": {
          "utf8": "#!/bin/sh\nset -eu\nread -r hello\ngeneration=$(printf '%s\\n' \"$hello\" | sed -n 's/.*\"generation\":\\([0-9][0-9]*\\).*/\\1/p')\nprintf '%s\\n' \"{\\\"protocol\\\":1,\\\"type\\\":\\\"hello-ack\\\",\\\"request_id\\\":\\\"p-100001\\\",\\\"generation\\\":$generation,\\\"payload\\\":{\\\"provider_name\\\":\\\"scenario-provider\\\",\\\"protocol\\\":1}}\"\nread -r configure\nprintf '%s\\n' \"{\\\"protocol\\\":1,\\\"type\\\":\\\"ready\\\",\\\"request_id\\\":\\\"p-100002\\\",\\\"generation\\\":$generation,\\\"payload\\\":{\\\"capabilities\\\":[\\\"actions\\\"]}}\"\nexit 23\n"
