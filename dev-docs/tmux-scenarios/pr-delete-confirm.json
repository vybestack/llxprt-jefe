{
  "schema": 1,
  "name": "pr-delete-confirm",
  "platform": "macos",
  "terminal": {
    "cols": 200,
    "rows": 36
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "work",
        "mode": 448
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n"
        },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Agent Types",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "p",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Pull Requests",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [],
      "absent": [
        "Delete Pull Request"
      ]
    },
    {
      "op": "key",
      "key": "d",
      "modifiers": ["shift"]
    },
    {
      "op": "assert-frame",
      "contains": [
        "Pull Requests"
      ],
      "absent": [
        "Delete Pull Request"
      ]
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": []
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
