{
  "schema": 1,
  "name": "issues-new-issue-typing",
  "platform": "macos",
  "terminal": {
    "cols": 120,
    "rows": 40
  },
  "workspace": {
    "mode": 448,
    "dirs": [
      {
        "path": "config",
        "mode": 448
      },
      {
        "path": "work",
        "mode": 448
      }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": {
          "utf8": "settings_schema = 2\n[keymap.\"issues.new-form\"]\n\"issues.new-submit\" = [\"F8\"]\n"
        },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Repositories",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "i",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "No issues found",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "n",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "New Issue",
      "timeout_ms": 15000
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "F8 submit",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "F8 submit"
      ],
      "absent": [
        "Alt+Enter submit"
      ]
    },
    {
      "op": "text",
      "text": "HelloTitle"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "HelloTitle",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "HelloTitle"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "tab",
      "modifiers": []
    },
    {
      "op": "text",
      "text": "Body line one"
    },
    {
      "op": "key",
      "key": "enter",
      "modifiers": []
    },
    {
      "op": "text",
      "text": "Body line two"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "Body line two",
      "timeout_ms": 15000
    },
    {
      "op": "assert-frame",
      "contains": [
        "Body line one"
      ],
      "absent": []
    },
    {
      "op": "assert-frame",
      "contains": [
        "Body line two"
      ],
      "absent": []
    },
    {
      "op": "assert-frame",
      "contains": [
        "HelloTitle"
      ],
      "absent": []
    },
    {
      "op": "key",
      "key": "backspace",
      "modifiers": []
    },
    {
      "op": "key",
      "key": "escape",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "No issue selected",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": ["control"]
    },
    {
      "op": "finish"
    }
  ],
  "secrets": []
}
