  "steps": [
    {
      "op": "launch",
      "argv": [
        "jefe",
        "--config",
        "${workspace}/config"
      ],
      "env": [],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "alpha",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "space",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "↕",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "down",
      "modifiers": []
    },
    {
      "op": "wait",
      "source": "frame",
      "literal": "↕ alpha",
      "timeout_ms": 15000
    },
    {
      "op": "key",
      "key": "enter",
      "modifiers": []
    },
    {
      "op": "assert-frame",
      "contains": [
        "bravo (1)",
        "alpha (1)",
        "charlie (1)"
      ],
      "absent": [
        "↕"
      ]
    },
    {
      "op": "key",
      "key": "q",
      "modifiers": [
        "control"
      ]
    },
    {
      "op": "finish"
    }
