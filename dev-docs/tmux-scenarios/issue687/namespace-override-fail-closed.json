{
  "schema": 1,
  "name": "issue687-namespace-override-fail-closed",
  "platform": "macos",
  "terminal": { "cols": 110, "rows": 32 },
  "workspace": {
    "mode": 448,
    "dirs": [
      { "path": "config", "mode": 448 },
      { "path": "work", "mode": 448 }
    ],
    "files": [
      {
        "path": "config/settings.toml",
        "content": { "utf8": "settings_schema = 2\n" },
        "mode": 384
      }
    ],
    "env": []
  },
  "steps": [
    {
      "op": "launch",
      "argv": ["jefe", "--config", "${workspace}/config"],
      "env": [
        { "name": "JEFE_SOCKET_PATH", "value": "relative/socket.sock" }
      ],
      "cwd": "work"
    },
    {
      "op": "wait",
      "source": "stderr",
      "literal": "JEFE_SOCKET_PATH",
      "timeout_ms": 15000
    },
    {
      "op": "wait",
      "source": "stderr",
      "literal": "absolute",
      "timeout_ms": 15000
    },
    { "op": "finish" }
  ],
  "secrets": []
}
